# Copy to project root as .env.docker. Generate three DIFFERENT random values.
DJANGO_SECRET_KEY=
QI_DB_PASSWORD=
QI_DB_ROOT_PASSWORD=
# Hostnames / IPs only; no scheme, path or port. Add the address assigned by admin.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Loopback until the administrator has configured campus network access rules.
QI_BIND_IP=127.0.0.1
# Target port: release any existing host binding before starting this stack.
QI_HTTP_PORT=8500

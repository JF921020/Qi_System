DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Local development defaults. Docker uses a separate .env.docker file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

#在虛擬機上運行時填入/proxy/8000，非虛擬機環境保留空白
FORCE_SCRIPT_NAME=

# Google 登入（Google Cloud Console > API 和服務 > 憑證 > OAuth 用戶端 ID，類型：網頁應用程式）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 留白時依請求自動產生 <網址>/accounts/google/callback/；經反向代理改變網域或 https 時請填完整網址
GOOGLE_OAUTH_REDIRECT_URI=
# 限制可登入的信箱網域，逗號分隔；留白代表任何已驗證的 Google 帳號
GOOGLE_ALLOWED_DOMAINS=
# 首次登入建立的角色：admin（管理者）或 viewer（檢視者）
GOOGLE_DEFAULT_ROLE=admin
# 登入後自動授予系統管理者（可管理平台使用者）的信箱，逗號分隔
PLATFORM_SUPERUSER_EMAILS=
